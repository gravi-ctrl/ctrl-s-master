# --- PYTHON GARBAGE ---
**/venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# Ignore sensitive env files
.env
**/.env

# --- LOGS & TEMP ---
**/*.log
**/*.tmp
**/*.bak

# ctrl_s_master
**/_logs/
**/_dry_run_output/
**/vaults.hc
**/vaults/
**/2fa/
**/backups/
**/status_dashboard.md
**/status.json
**/statefile.json

# breakglass/: only the scripts and the README belong in git
breakglass/*
!breakglass/*.py
!breakglass/README.md

# recovery-codes vaults and their backup folders, wherever they end up
**/*.rcv
**/*.rcv.backups/
**/decrypted.json
